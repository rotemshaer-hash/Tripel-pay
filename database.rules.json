{
  "rules": {
    ".read": false,
    ".write": false,

    "families": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('childLogins').child(auth.uid).child('familyUid').val() == $uid || root.child('parentLogins').child(auth.uid).child('familyUid').val() == $uid)",
        ".write": "auth != null && (auth.uid == $uid || root.child('parentLogins').child(auth.uid).child('familyUid').val() == $uid)",
        "children": {
          "$cid": {
            ".write": "auth != null && root.child('childLogins').child(auth.uid).child('familyUid').val() == $uid && root.child('childLogins').child(auth.uid).child('childId').val() == $cid"
          }
        }
      }
    },

    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? auth.uid == newData.child('familyUid').val() : auth.uid == data.child('familyUid').val())"
      }
    },

    "parentInviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? auth.uid == newData.child('familyUid').val() : auth.uid == data.child('familyUid').val())"
      }
    },

    "childLogins": {
      "$childUid": {
        ".read": "auth != null && auth.uid == $childUid",
        ".write": "auth != null && auth.uid == $childUid && !data.exists()"
      }
    },

    "parentLogins": {
      "$parentUid": {
        ".read": "auth != null && auth.uid == $parentUid",
        ".write": "auth != null && auth.uid == $parentUid && !data.exists()"
      }
    }
  }
}
