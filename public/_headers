# The HTML must always be re-checked: it is what points at the current bundle.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Everything under /assets carries a content hash in its name, so a given URL can
# never change meaning and is safe to keep forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
