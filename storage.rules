rules_version = '2';

// Storage rules cannot read the Realtime Database, so they cannot ask "does this
// person belong to that company?". Keying each object on its UPLOADER is a question
// they can answer alone: everyone writes only their own folder, and nobody can write
// into somebody else's. Reading is open to any signed-in user — a Firebase download
// URL carries an unguessable token, and that token is what actually keeps a file
// private; scoping reads more tightly would break sharing a task's evidence with the
// manager, who is a different account.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Anything outside that tree is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
